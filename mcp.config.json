{
  "servers": [
    {
      "id": "demo",
      "name": "Démo locale (météo, heure, calcul, notes)",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "tsx",
        "packages/mcp-demo-server/src/index.ts"
      ],
      "enabled": true,
      "allowedTools": [
        "get_weather",
        "get_time",
        "calculate",
        "list_notes",
        "add_note",
        "get_metrics",
        "get_sales_by_product",
        "list_alerts",
        "send_alert",
        "set_price"
      ],
      "writeTools": []
    },
    {
      "id": "demo-http",
      "name": "Démo en HTTP streamable (lancer `npm run start:http -w packages/mcp-demo-server`)",
      "transport": "http",
      "url": "http://localhost:4010/mcp",
      "enabled": false,
      "allowedTools": [
        "get_weather",
        "get_time",
        "get_metrics"
      ],
      "writeTools": []
    },
