{
  "name": "@es/ai-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"**/data/workspaces/**\" --exclude \"**/data/agent-template/**\" src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "dev:app-agents": "tsx watch src/app-agents/server.ts",
    "start:app-agents": "tsx src/app-agents/server.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.22.0",
    "fastify": "^5.2.0",
    "openai": "^7.60.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
