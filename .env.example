# ================= Moteur IA =================
# inception (défaut) | deepseek | openai | anthropic | mock
# Sans clé, le moteur bascule automatiquement sur le mock (démo sans clé).
LLM_PROVIDER=inception
# Clé DeepSeek (optionnel) : https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Clé Inception : https://platform.inceptionlabs.ai → API Keys. Ne jamais committer.
INCEPTION_API_KEY=
# Clé générique pour openai / anthropic (et repli)
LLM_API_KEY=
# Modèle : mercury-3 (défaut) | deepseek-flash | deepseek-v4-pro | gpt-4o-mini | claude-…
LLM_MODEL=mercury-3
# URL de base compatible OpenAI (défaut Inception : https://api.inceptionlabs.ai/v1 ;
# autres : https://api.deepseek.com, https://api.openai.com/v1 …)
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
# Raisonnement optionnel (DeepSeek / Mercury) : instant | low | medium | high
LLM_REASONING_EFFORT=instant
# Vitesse du streaming en mode mock (ms entre deux paquets de tokens)
MOCK_DELAY_MS=8

# ================= Équipe d'agents =================
# agent (défaut : Data Engineer → Product Owner → Développeur, CLI shadcn + vite build) | direct (génération en un appel)
GENERATION_MODE=agent
# Nombre max de renvois du PO au Développeur après revue
AGENT_MAX_REWORK=2

# ================= Ports =================
GATEWAY_PORT=4000
AI_ENGINE_PORT=4001
VALIDATOR_PORT=4002
STORAGE_PORT=4003
MCP_HUB_PORT=4004
APP_AGENTS_PORT=4005
VOICE_GATEWAY_PORT=4006

# ================= URLs internes (dev local ; docker-compose les surcharge) =================
AI_ENGINE_URL=http://localhost:4001
VALIDATOR_URL=http://localhost:4002
STORAGE_URL=http://localhost:4003
MCP_HUB_URL=http://localhost:4004
APP_AGENTS_URL=http://localhost:4005
VOICE_GATEWAY_URL=http://localhost:4006

# ================= Stockage =================
DB_PATH=./data/everything.db

# ================= MCP =================
# Fichier de configuration des serveurs MCP (relatif à services/mcp-hub)
MCP_CONFIG_PATH=../../mcp.config.json
# Autoriser l'ajout de serveurs stdio (= exécution de commandes locales) depuis l'UI. Laisser à false hors usage perso.
MCP_ALLOW_UI_STDIO=false

# ================= Voix du contremaître (Google) =================
# Mercury 3 (Inception) est TEXTE uniquement : il reste le cerveau (décisions, outils, actions).
# Google ne fait que la voix, exposée au contremaître comme des OUTILS : voice.speak / voice.listen / voice.confirm / voice.stop.
# Clé Gemini (https://aistudio.google.com/apikey). Lue seulement par voice-gateway, jamais envoyée au navigateur ni loguée.
# Vide → voix désactivée proprement (le chat écrit reste disponible).
GOOGLE_API_KEY=
# TTS (Gemini, generateContent audio) : gemini-3.8-flash-lite-tts (rapide, défaut) | gemini-3.8-flash-tts (plus expressif)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Voix fr-FR « Jarvis » (voix prédéfinies Gemini : Charon, Kore, Fenrir, Puck…)
GEMINI_TTS_VOICE=Charon
# STT en streaming (Gemini Live, transcription seule + détection d'activité vocale)
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
# Tests sans clé : moteur vocal factice
VOICE_MOCK=0
