# Copier en .env (ignoré par git) puis : chmod 600 .env

# Fournisseur LLM. Ordre : INCEPTION_API_KEY, puis OPENAI_API_KEY, sinon mode démo (mock déterministe).
# Inception Mercury (API OpenAI-compatible) :
INCEPTION_API_KEY=
# INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
# FORMULE_MODEL=mercury-3
# INCEPTION_REASONING_EFFORT=medium

# Ou tout fournisseur OpenAI-compatible :
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# La voix serveur (STT/TTS) n'utilise QUE OPENAI_API_KEY ; sinon reconnaissance/synthèse du navigateur.

# Mode public : Basic Auth sur la gateway.
FORMULE_PUBLIC=0
FORMULE_BASIC_USER=formule
FORMULE_BASIC_PASS=

FORMULE_DATA_DIR=./data
FORMULE_ALLOW_STDIO_UI=0
